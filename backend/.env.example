# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL - e.g. Neon connection string in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pantry_tracker?schema=public"

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email (SMTP - used for verification, password reset, expiry reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Smart Pantry Tracker"
SMTP_FROM_EMAIL=

# Uploads (local disk fallback; swap to Cloudinary when keys are available)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Cloudinary (optional - falls back to local disk storage if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI / third-party integrations (optional - endpoints return 501 until configured)
OPENAI_API_KEY=
GEMINI_API_KEY=
SPOONACULAR_API_KEY=
BARCODE_LOOKUP_API_KEY=
GOOGLE_VISION_API_KEY=

# Cron
EXPIRY_CHECK_CRON="0 8 * * *"
WEEKLY_REPORT_CRON="0 8 * * 1"
