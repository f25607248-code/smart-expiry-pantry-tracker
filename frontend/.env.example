# Local dev: leave VITE_API_URL unset to use Vite's /api proxy to http://localhost:4000 (see vite.config.ts).
# Deployed environments (e.g. Netlify): set VITE_API_URL to the deployed backend's origin.
VITE_API_URL=

# Optional: enables "Sign in with Google". Leave blank to hide the button.
VITE_GOOGLE_CLIENT_ID=
